# =====================================================================
# Enterprise RAG 2.0 — Production Environment Template (.env.example)
# =====================================================================
# Скопируйте этот файл в .env и укажите актуальные значения перед запуском.
# ВНИМАНИЕ: Никогда не коммитьте боевой файл .env в систему контроля версий!

# ---------------------------------------------------------------------
# 1. Безопасность и окружение
# ---------------------------------------------------------------------
# Режим окружения: development | staging | production
ENVIRONMENT=production

# Секретный ключ для сессий веб-интерфейса (минимум 32 символа).
# В production-режиме обязателен. Приложение завершит запуск с ошибкой,
# если ключ пустой или содержит дефолтное значение.
WEBUI_SECRET_KEY="your-secure-random-secret-key-min-32-chars"
WEBUI_PORT=3000

# ---------------------------------------------------------------------
# 2. Параметры генеративной модели (LLM)
# ---------------------------------------------------------------------
# Провайдер инференса: LM_STUDIO | OLLAMA_LOCAL | DOCKER
LLM_PROVIDER=LM_STUDIO
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5-14b-instruct-1m

# Температура генерации (0.0 - 0.1 для строгой фактологии без галлюцинаций)
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.2
LLM_MAX_TOKENS=1500
LLM_PRESENCE_PENALTY=0.1

# ---------------------------------------------------------------------
# 3. Параметры векторных эмбеддингов (Nomic v1.5 strictly 768-D)
# ---------------------------------------------------------------------
# В соответствии с GEMINI.md эмбеддинги ВСЕГДА запускаются на CPU
EMBEDDING_PROVIDER=REMOTE
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=not-needed
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
SENTENCE_TRANSFORMER_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DEVICE=cpu

# ---------------------------------------------------------------------
# 4. Параметры RAG-пайплайна и хранилища
# ---------------------------------------------------------------------
INDEX_FILE=rag_index.json
DATA_DIR=data
CHUNK_SIZE=1500
CHUNK_OVERLAP=350
RETRIEVAL_TOP_K=5
CONTEXT_MAX_CHUNKS=6
