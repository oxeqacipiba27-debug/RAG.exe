# =====================================================================
# EXSCIO RAG Client Edition — Конфигурация клиента
# =====================================================================

# 1. Адрес основного сервера инференса (LM Studio / OpenAI-совместимый API)
# Клиент подключается ИСКЛЮЧИТЕЛЬНО к данному серверу.
MAIN_SERVER_URL=http://localhost:1234/v1

# 2. Параметры языковой модели (LLM)
LLM_PROVIDER=LM_STUDIO
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5-14b-instruct-1m
LLM_TEMPERATURE=0.28
LLM_TOP_P=0.8
LLM_MAX_TOKENS=1500

# 3. Параметры модели эмбеддингов (обработка векторов строго на CPU)
EMBEDDING_PROVIDER=REMOTE
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=not-needed
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DEVICE=cpu

# 4. База знаний и параметры извлечения (режим "только для чтения")
INDEX_FILE=rag_index.json
DATA_DIR=data
RETRIEVAL_TOP_K=5
CONTEXT_MAX_CHUNKS=6

# 5. Сетевые параметры клиентского интерфейса
CLIENT_PORT=8501
