# =====================================================================
# RAG BACKEND CONFIGURATION (.env)
# =====================================================================

# ---------------------------------------------------------------------
# 1. ПРОВАЙДЕР ГЕНЕРАЦИИ (LLM)
# ---------------------------------------------------------------------
# Допустимые варианты: LM_STUDIO | OLLAMA_LOCAL | DOCKER | CUSTOM
LLM_PROVIDER=LM_STUDIO

# Базовый URL OpenAI-совместимого эндпоинта:
# - LM Studio (локально):             http://localhost:1234/v1
# - Ollama (на хосте):                 http://localhost:11434/v1
# - Ollama из Docker-контейнера к хосту: http://host.docker.internal:11434/v1
# - Ollama во внутренней Docker-сети:  http://ollama:11434/v1
# - vLLM (Docker / Kubernetes):        http://localhost:8000/v1
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=not-needed

# Имя модели:
# - LM Studio: qwen2.5-14b-instruct-1m
# - Ollama:    qwen2.5:14b
# - vLLM:      Qwen/Qwen2.5-14B-Instruct
LLM_MODEL=qwen2.5-14b-instruct-1m

# Гиперпараметры сэмплирования:
LLM_TEMPERATURE=0.28
LLM_TOP_P=0.8
LLM_MAX_TOKENS=1500

# ---------------------------------------------------------------------
# 2. ПРОВАЙДЕР ЭМБЕДДИНГОВ (EMBEDDINGS)
# ---------------------------------------------------------------------
# Допустимые варианты:
# - REMOTE                : через OpenAI-совместимый API (/v1/embeddings) в LM Studio / Ollama / vLLM
# - SENTENCE_TRANSFORMERS : локальный расчет через PyTorch / HuggingFace
EMBEDDING_PROVIDER=REMOTE

# Настройки для REMOTE:
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=not-needed
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Настройки для SENTENCE_TRANSFORMERS:
SENTENCE_TRANSFORMER_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DEVICE=cpu

# ---------------------------------------------------------------------
# 3. ПАРАМЕТРЫ RAG И ХРАНИЛИЩА
# ---------------------------------------------------------------------
INDEX_FILE=rag_index.json
DATA_DIR=data
CHUNK_SIZE=1500
CHUNK_OVERLAP=350
RETRIEVAL_TOP_K=5
CONTEXT_MAX_CHUNKS=6
