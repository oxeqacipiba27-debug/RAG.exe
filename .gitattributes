# Auto-detect text files and normalize LF in repository
* text=auto

# Shell scripts and Linux configuration files must always have LF line endings
*.sh text eol=lf
PKGBUILD text eol=lf
*.install text eol=lf
*.service text eol=lf
*.desktop text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.env* text eol=lf
