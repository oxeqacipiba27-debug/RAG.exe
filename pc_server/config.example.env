# ==============================================================================
# Windows 11 RTX 4070 Inference Host Configuration
# ==============================================================================

# Server Network Binding
# 0.0.0.0 allows connections from Localhost, Local LAN (192.168.x.x), and Tailscale VPN (100.x.x.x)
PC_SERVER_HOST=0.0.0.0
PC_SERVER_PORT=8000

# Security API Key (Optional)
# Leave empty for open access within private Tailscale mesh or trusted LAN.
# Or set a secret token (e.g. sk-my-secret-key-12345) to require Bearer authentication.
PC_SERVER_API_KEY=

# Allow /health endpoint without API key (allows SwayFX / Waybar widget to query status)
PC_SERVER_ALLOW_UNAUTH_HEALTH=true

# Model storage directory (absolute path or relative to pc_server/)
PC_SERVER_MODELS_DIR=./models

# Default context window size (tokens)
# Recommended RTX 4070 values: 8192, 16384, 32768
PC_SERVER_DEFAULT_CTX=16384

# Number of GPU layers to offload to RTX 4070 (-1 offloads ALL layers into 12GB VRAM)
PC_SERVER_GPU_LAYERS=-1

# Number of CPU threads for token decoding
PC_SERVER_THREADS=8

# Optional: GGUF model to load automatically on server startup
PC_SERVER_DEFAULT_MODEL=Qwen2.5-14B-Instruct-Q4_K_M.gguf

# Embedding Configuration (Standard 768 dimensions for nomic-embed-text-v1.5)
PC_SERVER_EMBEDDING_DIM=768
