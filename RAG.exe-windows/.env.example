# ==============================================================================
# EXSCIO 2.0 — Production Environment Template (.env.example) для Windows 10/11
# ==============================================================================
# Скопируйте этот файл в .env перед первым запуском.
# Скрипт start.bat скопирует его автоматически, если .env отсутствует.

# ------------------------------------------------------------------------------
# 1. Безопасность и окружение
# ------------------------------------------------------------------------------
ENVIRONMENT=production
WEBUI_SECRET_KEY="exscio-windows-secure-session-key-min-32-chars-change-in-prod"
WEBUI_PORT=8501

# ------------------------------------------------------------------------------
# 2. Параметры генеративной модели (LLM)
# ------------------------------------------------------------------------------
# Варианты LLM_PROVIDER:
#   LM_STUDIO      -> локальный инференс через LM Studio (порт 1234)
#   OLLAMA_LOCAL   -> нативный сервис Ollama для Windows (порт 11434)
#   DOCKER         -> Docker Desktop с контейнером Ollama под WSL2 (порт 11434)
#   RTX4070_REMOTE -> удаленный сервер NVIDIA RTX 4070 (порт 8000 через LAN/Tailscale)
LLM_PROVIDER=LM_STUDIO
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5-14b-instruct-1m

# Параметры инференса (строгая фактология без галлюцинаций)
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.2
LLM_MAX_TOKENS=1500
LLM_PRESENCE_PENALTY=0.1

# ------------------------------------------------------------------------------
# 3. Векторные эмбеддинги (Nomic Embed v1.5, строго 768-D)
# ------------------------------------------------------------------------------
# Согласно стандартам GEMINI.md, эмбеддинги ВСЕГДА выполняются на CPU (RAM),
# чтобы 100% VRAM видеокарты было выделено под 14B модель генерации (Qwen2.5-14B).
EMBEDDING_PROVIDER=REMOTE
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=not-needed
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
SENTENCE_TRANSFORMER_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DEVICE=cpu

# ------------------------------------------------------------------------------
# 4. Параметры поискового RAG-пайплайна и хранилища
# ------------------------------------------------------------------------------
INDEX_FILE=rag_index.json
DATA_DIR=data
CHUNK_SIZE=1500
CHUNK_OVERLAP=350
RETRIEVAL_TOP_K=5
CONTEXT_MAX_CHUNKS=6

# ------------------------------------------------------------------------------
# 5. Интеграционный API-сервер (REST / SSE)
# ------------------------------------------------------------------------------
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
RAG_API_KEY=
RAG_API_RELOAD=false

# ------------------------------------------------------------------------------
# 6. Интеграция с Telegram-ботом (aiogram 3.x)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
RAG_API_BASE_URL=http://localhost:8000/api/v1
