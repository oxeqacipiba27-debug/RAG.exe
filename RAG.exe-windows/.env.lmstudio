# =====================================================================
# Enterprise RAG 2.0 — LM Studio Backend Profile (.env.lmstudio)
# =====================================================================
ENVIRONMENT=production
WEBUI_SECRET_KEY="your-secure-random-secret-key-min-32-chars"
WEBUI_PORT=3000

# Параметры генеративной модели (LLM) — LM Studio (Порт 1234)
LLM_PROVIDER=LM_STUDIO
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5-14b-instruct-1m

LLM_TEMPERATURE=0.0
LLM_TOP_P=0.2
LLM_MAX_TOKENS=1500
LLM_PRESENCE_PENALTY=0.1

# Параметры векторных эмбеддингов (Nomic v1.5 strictly 768-D)
EMBEDDING_PROVIDER=REMOTE
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=not-needed
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
SENTENCE_TRANSFORMER_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DEVICE=cpu

# Хранилище и RAG
INDEX_FILE=rag_index.json
DATA_DIR=data
CHUNK_SIZE=1500
CHUNK_OVERLAP=350
RETRIEVAL_TOP_K=5
CONTEXT_MAX_CHUNKS=6

# Интеграционный API сервер
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000
RAG_API_KEY=
RAG_API_RELOAD=false

# Telegram-бот
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
RAG_API_BASE_URL=http://localhost:8000/api/v1
